  "count": 67,
  "statusGlyphs": {
    "rule": "Exactly six shapes. Shape carries the meaning, colour supports it. Always pair with a text label nearby. Drawn on a 14 px grid, rendered at 14, 16 or 20 px. Not Lucide, not a brand mark.",
    "items": [
      {
        "id": "open",
        "label": "Open",
        "meaning": "An open bug",
        "shape": "Filled disc",
        "colourToken": "--hb-color-status-open"
      },
      {
        "id": "in-progress",
        "label": "In progress",
        "meaning": "A fix is being worked on",
        "shape": "Ring with the left half filled",
        "colourToken": "--hb-color-status-in-progress"
      },
      {
        "id": "fixed",
        "label": "Fixed",
        "meaning": "Fixed in a release",
        "shape": "Ring with a check mark",
        "colourToken": "--hb-color-status-fixed"
      },
      {
        "id": "duplicate",
        "label": "Duplicate",
        "meaning": "Merged into another issue",
        "shape": "Ring with a slash",
        "colourToken": "--hb-color-status-neutral"
      },
      {
        "id": "not-planned",
        "label": "Not planned",
        "meaning": "Closed: maintainers will not work on it",
        "shape": "Ring with a level bar",
        "colourToken": "--hb-color-status-neutral"
      },
      {
        "id": "pending",
        "label": "Waiting",
        "meaning": "Waiting on someone, for example reporters to confirm a fix",
        "shape": "Dashed ring",
        "colourToken": "--hb-color-status-neutral"
      }
    ]
  },
  "notIcons": ["The brand mark", "Status glyphs", "Emoji", "Flags"]
}

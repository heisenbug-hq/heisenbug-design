{
  "name": "heisenbug-icons",
  "version": "1.1.0",
  "date": "2026-10-31",
  "source": {
    "set": "Lucide",
    "package": "lucide-static",
    "version": "1.66.0",
    "licence": "ISC",
    "licenceFile": "LICENSE-lucide.txt"
  },
  "rules": {
    "grid": 24,
    "sizes": [16, 20, 24],
    "renderedStrokePx": 1.5,
    "strokeViewBoxUnits": {
      "16": 2.25,
      "20": 1.8,
      "24": 1.5
    },
    "caps": "round",
    "joins": "round",
    "style": "outline only",
    "color": "currentColor",
    "iconOnlyButton": {
      "ariaLabel": "required",
      "tooltip": "required",
      "hitAreaPx": {
        "desktop": 36,
        "phone": 44
      }
    },
    "decorativeIcons": "aria-hidden",
    "closedSet": true,
    "additions": "by Lucide name, in a pull request with the reason"
  },
  "icons": {
    "Navigation": [
      "house",
      "compass",

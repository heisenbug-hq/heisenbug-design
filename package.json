{
  "name": "@heisenbughq/design",
  "version": "0.3.0",
  "type": "module",
  "description": "Heisenbug theme tokens and canonical UI standards.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heisenbug-hq/heisenbug-design.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "26.x"
  },
  "files": [
    "dist/",
    "bin/",
    "icons/",
    "fonts/",
    "brand/svg/heisenbug-lockup-dark.svg",
    "brand/svg/heisenbug-lockup-light.svg",
    "brand/svg/heisenbug-mark-dark.svg",
    "brand/svg/heisenbug-mark-light.svg",
    "brand/favicon/",
    "BRAND-USE.md",
    "DESIGN.md",
    "docs/ui-standards.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./fonts/*",
    "./icons/sprite.svg": "./icons/sprite.svg",
    "./icons/manifest.json": "./icons/manifest.json",
    "./icons/icon.mjs": "./icons/icon.mjs",
    "./icons/*.svg": "./icons/icons/*.svg",
    "./status/*.svg": "./icons/status/*.svg",
    "./brand/svg/heisenbug-lockup-dark.svg": "./brand/svg/heisenbug-lockup-dark.svg",
    "./brand/svg/heisenbug-lockup-light.svg": "./brand/svg/heisenbug-lockup-light.svg",
    "./brand/svg/heisenbug-mark-dark.svg": "./brand/svg/heisenbug-mark-dark.svg",
    "./brand/svg/heisenbug-mark-light.svg": "./brand/svg/heisenbug-mark-light.svg",
    "./brand/favicon/*": "./brand/favicon/*",
    "./BRAND-USE.md": "./BRAND-USE.md",
    "./package.json": "./package.json"
  },
  "bin": {
    "heisenbug-design-sync": "bin/sync.mjs",
    "heisenbug-design-check": "bin/check.mjs"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "contrast": "node tools/contrast.mjs",
    "lint:design": "npx @google/design.md@0.4.0 lint DESIGN.md",
    "drift": "node tools/drift.mjs",
    "fonts": "node tools/fonts.mjs",
    "fonts:check": "node tools/fonts.mjs --check",
    "guards": "node tools/guards.mjs",
    "icons": "node tools/icons.mjs",
    "sprite": "node tools/sprite.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "check": "prettier --check . && pnpm build && pnpm contrast && pnpm lint:design && pnpm drift && pnpm fonts:check && pnpm guards && pnpm icons && pnpm test",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@fontsource/geist": "5.3.0",
    "@fontsource/spline-sans-mono": "5.3.0",
    "@google/design.md": "0.4.0",
    "@xmldom/xmldom": "0.9.12",
    "prettier": "3.10.1",
    "vitest": "5.1.1",
    "yaml": "2.9.1"
  }
}

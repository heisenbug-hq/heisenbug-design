#!/usr/bin/env bash
# Rejects a commit unless the message is exactly one Conventional Commit line.
# No body, no trailers, no em dash, no emoji. See AGENTS.md.
set -u
export LC_ALL=C

msg_file="${1:-}"
if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
  echo "commit-msg: commit message file not found" >&2
  exit 1
fi

fail() {
  echo "commit-msg: $1" >&2
  exit 1
}

# When an editor was used, git leaves its template comments in the file.
editor_template=0
if grep -q '^# Please enter the commit message' "$msg_file"; then
  editor_template=1
fi

lines=()
while IFS= read -r line || [ -n "$line" ]; do
  line="${line%$'\r'}"
  if [ "$editor_template" -eq 1 ] && [[ "$line" == \#* ]]; then
    continue
  fi
  if [[ -z "${line//[[:space:]]/}" ]]; then
    continue
  fi
  lines+=("$line")
done < "$msg_file"

if [ "${#lines[@]}" -eq 0 ]; then
  fail "empty commit message"
fi

first="${lines[0]}"

# Messages generated by git itself are allowed as they are.
if [[ "$first" == "Merge "* || "$first" == 'Revert "'* ]]; then
  exit 0
fi

if [ "${#lines[@]}" -ne 1 ]; then
  fail "the message must be exactly one line (no body, no trailers such as Co-Authored-By)"
fi

if [[ "$first" == *$'\xe2\x80\x94'* ]]; then
  fail "no em dash (U+2014) allowed; use a hyphen, comma or colon"
fi

emoji_re=$'\xf0\x9f|\xef\xb8\x8f|\xe2\x80\x8d|\xe2\x83\xa3|\xe2[\x98-\x9e][\x80-\xbf]|\xe2[\xac-\xaf][\x80-\xbf]'
if [[ "$first" =~ $emoji_re ]]; then
  fail "no emoji allowed in the commit message"
fi

subject_re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,100}$'
if ! [[ "$first" =~ $subject_re ]]; then
  fail "the subject must look like 'type(scope): subject' with type feat, fix, docs, style, refactor, perf, test, build, ci, chore or revert (subject up to 100 characters)"
fi

exit 0
